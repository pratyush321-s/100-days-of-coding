#include <stdio.h>

enum Operations
{
    ADD = 1,
    SUBTRACT,
    MULTIPLY
};

int main()
{
    int a, b, choice;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    printf("\n1. ADD");
    printf("\n2. SUBTRACT");
    printf("\n3. MULTIPLY");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    switch (choice)
    {
        case ADD:
            printf("Result = %d", a + b);
            break;

        case SUBTRACT:
            printf("Result = %d", a - b);
            break;

        case MULTIPLY:
            printf("Result = %d", a * b);
            break;

        default:
            printf("Invalid Choice");
    }

    return 0;
}
