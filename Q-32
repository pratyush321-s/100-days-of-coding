#include <stdio.h>

enum Traffic
{
    RED,
    YELLOW,
    GREEN
};

int main()
{
    enum Traffic light;

    light = RED;

    switch (light)
    {
        case RED:
            printf("STOP");
            break;

        case YELLOW:
            printf("WAIT");
            break;

        case GREEN:
            printf("GO");
            break;

        default:
            printf("Invalid Traffic Light");
    }

    return 0;
}
